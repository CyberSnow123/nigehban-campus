# API settings (copy to .env, never commit .env)
DATABASE_URL=postgresql+psycopg://nigehban:nigehban@localhost:5432/nigehban
# Both secrets must be at least 32 characters. Generate each with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
WORKER_KEY=
DATA_DIR=../../data
CV_CONFIG=../../services/cv/config.json

# Password-reset email. "console" logs the reset link instead of sending (dev default).
# For Gmail use MAIL_BACKEND=smtp with a Google App Password (needs 2-step verification):
#   https://myaccount.google.com/apppasswords  (the normal Gmail password does not work)
MAIL_BACKEND=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Base URL of the web app, used in the reset link
WEB_BASE_URL=http://localhost:5173

# Login rate limit per client address, e.g. 10/minute or 10/minute;50/hour (kept in memory)
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT=10/minute

# Docker host port for PostgreSQL (change both this and DATABASE_URL if 5432 is taken)
DB_PORT=5432
